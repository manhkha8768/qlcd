# Staging Environment Configuration

# Application
NODE_ENV=staging
ENVIRONMENT=staging
DEBUG=false

# Backend API
BACKEND_URL=https://qlcd-api-staging.workers.dev
API_TIMEOUT=30000

# Frontend
FRONTEND_URL=https://qlcd-staging.pages.dev

# Database
D1_DATABASE_ID=
D1_DATABASE_URL=

# Storage
R2_BUCKET_NAME=qlcd-files-staging
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cache
KV_NAMESPACE_ID=

# Authentication
JWT_SECRET=staging-secret-key-change-before-production
SESSION_TIMEOUT=3600
SECURE_COOKIES=true

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGINS=https://qlcd-staging.pages.dev
