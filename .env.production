# Production Environment Configuration
# SENSITIVE: Keep this file out of version control
# Use GitHub Secrets or Cloudflare environment variables instead

# Application
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

# Backend API
BACKEND_URL=https://qlcd-api.workers.dev
API_TIMEOUT=30000

# Frontend
FRONTEND_URL=https://qlcd.workers.dev

# Database
D1_DATABASE_ID=
D1_DATABASE_URL=

# Storage
R2_BUCKET_NAME=qlcd-files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cache
KV_NAMESPACE_ID=

# Authentication
JWT_SECRET=MUST_BE_SET_VIA_CLOUDFLARE_SECRETS
SESSION_TIMEOUT=3600
SECURE_COOKIES=true

# Logging
LOG_LEVEL=error

# CORS
CORS_ORIGINS=https://qlcd.workers.dev
