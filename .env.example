# Database
QLCD_DB=/data/db/qlcd.db

# Upload directory
QLCD_UPLOAD=/data/uploads

# Server
PORT=3000
QLCD_HOST=0.0.0.0
NODE_ENV=production

# Session
QLCD_PHIEN_GIO=8
QLCD_SECRET=your-secure-random-secret-here

# Deployment
QLCD_INTERNET=1

# TASK 26 — chỉ dùng cho staging UAT, không đặt cùng database production
QLCD_UAT_SOURCE_DB=
QLCD_UAT_DB=
QLCD_UAT_PASSWORD=
QLCD_UAT_UPLOAD=
QLCD_UAT_EVIDENCE=

# Quick Tunnel staging (never point these at production data)
QLCD_STAGING_SECRET=
QLCD_STAGING_PORT=
QLCD_STAGING_DB=
QLCD_STAGING_UPLOAD=
QLCD_STAGING_BACKUP_DIR=
# Google Sheets (share the target Sheet with this service-account email)
# Preferred: absolute path to a JSON key stored outside the repository.
QLCD_GOOGLE_CREDENTIALS_FILE=
QLCD_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep literal \\n sequences when stored on one line.
QLCD_GOOGLE_PRIVATE_KEY=
# Optional: reuse one spreadsheet; leave empty to create a new one on export.
QLCD_GOOGLE_SPREADSHEET_ID=
